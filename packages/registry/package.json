{
  "name": "@aura-design/registry",
  "version": "1.0.0",
  "description": "Aura Design System Registry",
  "type": "module",
  "keywords": [],
  "author": "Pablo Orozco <me@pablopvsky.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somosgented/aura-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/somosgented/aura-design-system/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "pnpm ladle preview",
    "build": "pnpm ladle build -o build && cp public/favicon.ico public/favicon.svg public/touch-icon.png public/mask-icon.svg build/",
    "dev": "pnpm ladle serve",
    "registry:serve": "pnpm dlx serve public -p 6000",
    "registry:build": "shadcn build -o ../../apps/www/public/r",
    "sync:rules": "npx tsx scripts/sync-rules.ts",
    "sync:skills": "npx tsx scripts/sync-skills.ts",
    "sync:design-md": "npx tsx scripts/sync-design-md.ts",
    "registry:generate": "pnpm sync:rules && pnpm sync:skills && pnpm sync:design-md && npx tsx scripts/build-registry.ts",
    "docs:generate": "pnpm sync:rules && pnpm sync:skills && pnpm sync:design-md && npx tsx scripts/generate-docs.ts && npx tsx scripts/generate-rules-docs.ts",
    "docs:rules": "npx tsx scripts/generate-rules-docs.ts",
    "new:rule": "npx tsx scripts/new-rule.ts",
    "fixtures:presentation": "npx tsx scripts/generate-presentation-fixture.ts",
    "registry:bootstrap": "pnpm registry:generate && pnpm registry:build && pnpm docs:generate",
    "test": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@diceui/mention": "^1.0.0",
    "@diceui/pptx": "0.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.9",
    "@ladle/react": "^5.1.1",
    "@lexical/code": "^0.39.0",
    "@lexical/headless": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/selection": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@lexical/utils": "^0.39.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "bezier-easing": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colorjs.io": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "lexical": "^0.39.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.1.2",
    "react": "^19.2.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.1",
    "react-resizable-panels": "2.1.9",
    "recharts": "2.15.4",
    "shadcn": "3.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.14",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "jsdom": "^27.2.0",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.13"
  }
}
