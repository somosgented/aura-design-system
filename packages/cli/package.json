{
  "name": "@aura-design/cli",
  "version": "1.3.1",
  "description": "Aura Design System CLI",
  "type": "module",
  "keywords": [
    "react",
    "react-component",
    "uikit",
    "ui-library",
    "ui-components",
    "cli"
  ],
  "author": "Pablo Orozco <me@pablopvsky.com>",
  "license": "MIT",
  "bin": {
    "aura": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somosgented/aura-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/somosgented/aura-design-system/issues"
  },
  "scripts": {
    "build": "tsc --build && rm -rf dist/templates && mkdir -p dist/templates && cp -R templates/. dist/templates/",
    "dev": "tsc --watch",
    "link": "npm link",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@radix-ui/colors": "^3.0.0",
    "bezier-easing": "^2.1.0",
    "chalk": "^5.4.1",
    "colorjs.io": "^0.5.2",
    "commander": "^11.1.0",
    "execa": "^9.5.3",
    "glob": "^13.0.0",
    "inquirer": "^12.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/node": "^20",
    "typescript": "^5.0.0"
  }
}
